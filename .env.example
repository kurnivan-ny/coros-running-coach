# Copy to .env and fill in. NEVER commit .env.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset to use SQLite (local development and CI).
DATABASE_URL=
CORACH_SQLITE_PATH=data/corach.db

# Production: any Postgres. Free-tier options, in the order we'd pick them:
#
# 1) Neon (recommended). Compute sleeps after ~5 min and WAKES AUTOMATICALLY on
#    the next connection, so an idle dashboard needs no intervention. 1 GB per
#    project. Use the *-pooler* hostname: Streamlit reruns the script on every
#    interaction and would otherwise churn direct connections.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# 2) Supabase. Workable, but a free project PAUSES after 7 days of inactivity
#    and must be unpaused by hand in the dashboard, which makes the scheduled
#    ingest load-bearing. Use the pooler on port 6543, not 5432.
# DATABASE_URL=postgresql://user:password@host:6543/postgres

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
# synthetic = SYNTHETIC demo data. coros_mcp = real adapter (currently a stub).
CORACH_SOURCE=synthetic
CORACH_OVERLAP_DAYS=3

# COROS MCP (UNVERIFIED - the adapter is a stub that fails loudly)
COROS_MCP_URL=
COROS_MCP_TOKEN=

# ---------------------------------------------------------------------------
# LLM phrasing (OPTIONAL)
# ---------------------------------------------------------------------------
# The chat works fully without this: it falls back to deterministic, rule-based
# answers. The LLM never writes SQL and never computes a statistic -- it may
# only rephrase verified facts, and any number not present in those facts is
# rejected. Only aggregates are sent, never raw activity rows.
#
# https is required unless the host is localhost. The key is never logged.
# Raise LLM_TIMEOUT for slow (e.g. CPU-only) backends; default is 20s.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# LLM_TIMEOUT=20

# Free-tier providers, with their data policies verified on 2026-10-17/19:
#
# Cloudflare Workers AI -- explicit: "Cloudflare does not use Customer Content
#   processed by Workers AI to train AI models." Not retained after the request.
# LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# LLM_MODEL=@cf/meta/llama-3.1-8b-instruct
#
# Ollama Cloud -- explicit: "We do not use your inputs or outputs to train any
#   AI models"; prompts processed transiently. Free tier gives a small monthly
#   starter credit allowance (exact figure unpublished) and 1 concurrent request.
# LLM_BASE_URL=https://ollama.com/v1
# LLM_MODEL=gpt-oss:20b
#
# Local Ollama -- http is allowed here because the host is loopback.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2:1b
# LLM_API_KEY=ollama
#
# AVOID the Google Gemini FREE tier for personal data: its terms say content is
# used "to provide, improve, and develop" Google products and that human
# reviewers may read inputs and outputs. (Activating Cloud Billing moves API
# usage to paid-tier data handling; AI Studio stays free-tier regardless.)

# ---------------------------------------------------------------------------
# dbt gold layer (Postgres only; see requirements-dbt.txt)
# ---------------------------------------------------------------------------
# PGHOST=ep-xxx-pooler.region.aws.neon.tech
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=neondb
# PGSCHEMA=public
