# Copy to .env and fill in. NEVER commit .env.
# --- Database ---
# Local/CI default is SQLite; leave DATABASE_URL unset to use it.
# Production (Supabase pooler, port 6543):
# DATABASE_URL=postgresql://user:password@host:6543/postgres
DATABASE_URL=
CORACH_SQLITE_PATH=data/corach.db

# --- Ingestion source ---
# synthetic = SYNTHETIC demo data. coros_mcp = real adapter (currently a stub).
CORACH_SOURCE=synthetic
CORACH_OVERLAP_DAYS=3

# --- COROS MCP (UNVERIFIED - adapter is a stub) ---
COROS_MCP_URL=
COROS_MCP_TOKEN=

# --- LLM phrasing (optional; chat works without it) ---
# Must be https unless localhost. Key is never logged.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
