# Copy to .env and fill in. NEVER commit .env.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production and the dashboard use Postgres (Neon). Either set DATABASE_URL, or
# the standard libpq variables below; DATABASE_URL wins when both are present.
#
# Use Neon's POOLED host (-pooler): Streamlit reruns the script on every
# interaction and would otherwise churn direct connections.
DATABASE_URL=
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# PGHOST=ep-xxx-pooler.region.aws.neon.tech
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=neondb

# Leave both unset to use SQLite. SQLite holds bronze only (ingest and unit tests):
# silver and gold are dbt models and need Postgres.
CORACH_SQLITE_PATH=data/corach.db

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
# coros_snapshot = real COROS data saved by a Claude session (docs/DATA_IMPORT.md)
# synthetic      = generated demo data, for CI and trying the app
CORACH_SOURCE=coros_snapshot
CORACH_SNAPSHOT_DIR=data/coros_raw
CORACH_OVERLAP_DAYS=3

# ---------------------------------------------------------------------------
# Strava (OPTIONAL) -- an unattended source, unlike the COROS snapshot
# ---------------------------------------------------------------------------
# Create an API app at https://www.strava.com/settings/api, then authorise it ONCE
# with the helper (do not copy the refresh token from that page: it is read-only
# and cannot list activities):
#     python -m corach.strava_auth                      # prints the URL to open
#     python -m corach.strava_auth "<redirected URL>"   # saves the token to .env
# Then:  python -m corach.ingest --source strava
# Rotated tokens are written back here automatically; on GitHub you must update
# the STRAVA_REFRESH_TOKEN secret by hand. Read Strava's API agreement before
# sending Strava data to any LLM.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Answer engines for "Ask your data" (ALL OPTIONAL)
# ---------------------------------------------------------------------------
# With nothing below the chat is fully functional: deterministic, rule-based
# answers from whitelisted read-only tools, at zero cost.
#
# Every engine below sees only aggregates, never raw rows, never writes SQL, and
# has any answer containing an unverified number discarded.

# (a) Claude with tool calling. Needs an Anthropic API key WITH CREDIT -- a
#     Claude Pro subscription does not include API usage. Billed per token; the
#     default model is the cheapest. Keys: https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5

# (b) Any OpenAI-compatible endpoint that only rephrases verified facts.
#     https is required unless the host is localhost. The key is never logged.
#     Raise LLM_TIMEOUT for slow (e.g. CPU-only local) backends; default 20s.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# LLM_TIMEOUT=20

# Free / local options, data policies checked 2026-10-17/19:
#
# Local Ollama -- free, nothing leaves your machine:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
#
# Cloudflare Workers AI -- explicit: "Cloudflare does not use Customer Content
#   processed by Workers AI to train AI models." Not retained after the request.
# LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# LLM_MODEL=@cf/meta/llama-3.1-8b-instruct
#
# Ollama Cloud -- explicit: "We do not use your inputs or outputs to train any
#   AI models"; prompts processed transiently. Small free allowance, 1 concurrent
#   request.
# LLM_BASE_URL=https://ollama.com/v1
# LLM_MODEL=gpt-oss:20b
#
# Avoid the Gemini free tier for personal data: its terms allow training on
# inputs and human review.
