# Streamlit Community Cloud: paste these into
#   Manage app -> Settings -> Secrets
# Locally: copy to .streamlit/secrets.toml (gitignored, NEVER commit it).
#
# app.py reads configuration from the environment, and secrets.toml entries are
# exposed to the app as st.secrets -- app.py copies them into os.environ at
# startup, so the same names work in both places.

# Neon POOLED connection string (note -pooler), ending ?sslmode=require
DATABASE_URL = "postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Optional. Omit everything below for free, deterministic answers only.
#
# Claude with tool calling. Needs an Anthropic API key with credit; a Claude Pro
# subscription does NOT include API credit. Billed per token.
# ANTHROPIC_API_KEY = "sk-ant-..."
# CLAUDE_MODEL = "claude-haiku-5-5"
#
# OR any OpenAI-compatible host (free tiers exist) that only rephrases facts:
# LLM_BASE_URL = "https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1"
# LLM_MODEL = "@cf/meta/llama-3.1-8b-instruct"
# LLM_API_KEY = "..."
