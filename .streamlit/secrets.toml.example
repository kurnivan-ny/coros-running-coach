# Streamlit Community Cloud: paste these into
#   Manage app -> Settings -> Secrets
# Locally: copy to .streamlit/secrets.toml (gitignored, NEVER commit it).
#
# app.py reads configuration from the environment, and secrets.toml entries are
# exposed to the app as st.secrets -- app.py copies them into os.environ at
# startup, so the same names work in both places.

DATABASE_URL = "postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

